    "width": 1080,
    "height": 500,
    "background": "#ffffff"
  },
  "layout": {
    "type": "manual",
    "card_width": 220,
    "card_height": 100,
    "fixed_icon_axis": true
  },
  "nodes": [
    {
      "id": "aws_boundary",
      "title": "AWS trigger path",
      "variant": "boundary",
      "color": "amber",
      "contains": ["sns", "lambda", "agent"]
    },
    {
      "id": "alert",
      "title": "Alert",
      "variant": "icon",
      "icon": "alert",
      "color": "red",
      "x": 40,
      "y": 132
    },
    {
      "id": "sns",
      "title": "SNS topic",
      "variant": "icon",
      "icon": "queue",
      "color": "amber",
      "x": 180,
      "y": 132
    },
    {
      "id": "lambda",
      "title": "Lambda",
      "variant": "icon",
      "icon": "lambda",
      "color": "amber",
      "x": 372,
      "y": 132
    },
    {
      "id": "agent",
      "title": "Agent",
      "subtitle": "Container job",
      "icon": "robot",
      "color": "purple",
      "x": 530,
      "y": 110
    },
    {
      "id": "access_boundary",
