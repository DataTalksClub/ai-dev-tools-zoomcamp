{
  "title": "OpenAPI becomes the shared contract",
  "description": "The frontend describes the API it expects in OpenAPI. The backend is then implemented against the same explicit contract.",
  "canvas": {
    "width": 960,
    "height": 400,
    "background": "#ffffff"
  },
  "layout": {
